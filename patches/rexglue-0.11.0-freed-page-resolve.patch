 #include <algorithm>
+#include <bit>
 #include <cstring>
 #include <memory>
 #include <utility>
@@ -286,6 +287,21 @@ void SharedMemory::MarkRangeValid(u32 start, u32 length, bool written_by_gpu) {
       if (i == valid_block_last && (valid_page_last & 63) != 63) {
         valid_bits &= (static_cast<u64>(1) << ((valid_page_last & 63) + 1)) - 1;
       }
+      if (written_by_gpu) {
+        // The GPU runs behind the title, so a resolve can land in memory the title has freed. Such
+        // pages cannot be watched. Kept valid, they would hide what the title writes there after
+        // it allocates them again.
+        u64 freed = 0;
+        for (u64 bits = valid_bits; bits != 0; bits &= bits - 1) {
+          const u32 bit = static_cast<u32>(std::countr_zero(bits));
+          if (!physical_memory_.IsPhysicalAccessible(((i << 6) + bit) << page_size_log2_)) {
+            freed |= static_cast<u64>(1) << bit;
+          }
+        }
+        system_page_flags_valid_[i] &= ~freed;
+        system_page_flags_valid_and_gpu_written_[i] &= ~freed;
+        valid_bits &= ~freed;
+      }
       system_page_flags_valid_[i] |= valid_bits;
       u64& gpu_written = system_page_flags_valid_and_gpu_written_[i];
       gpu_written = written_by_gpu ? (gpu_written | valid_bits) : (gpu_written & ~valid_bits);
