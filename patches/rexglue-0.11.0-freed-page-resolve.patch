+bool TitleContext::IsPhysicalAccessible(u32 address) {
+  if (!InPhysical(address, 1)) {
+    return false;
+  }
+  u32 protect = 0;
+  return StateOf(runtime_).GetAddressSpace()->GetPhysicalHeap()->QueryProtect(address, &protect) &&
+         (protect & (kMemoryProtectRead | kMemoryProtectWrite)) != 0;
+}
+
 ScopeGuard TitleContext::AddWriteListener(IPhysicalWriteListener& listener) {
   kernel::GuestAddressSpace* memory = StateOf(runtime_).GetAddressSpace();
   void* registration = memory->RegisterPhysicalMemoryInvalidationCallback(&WriteThunk, &listener);
