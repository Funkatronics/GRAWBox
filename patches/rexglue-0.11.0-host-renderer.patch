diff --git a/src/gpu/xenos/host_renderer.h b/src/gpu/xenos/host_renderer.h
new file mode 100644
index 00000000..dbad6328
--- /dev/null
+++ b/src/gpu/xenos/host_renderer.h
@@ -0,0 +1,21 @@
+/**
+ * @file        gpu/xenos/host_renderer.h
+ * @brief       Lets a host renderer draw the title's frames instead of the Xenos drivers
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+
+namespace rex::gpu {
+
+/** True while a host renderer draws: packets still run, without draws, shader loads and presents. */
+inline std::atomic<bool> host_renderer_draws = false;
+
+/** True while a host renderer presents: the drivers leave the window alone. */
+inline std::atomic<bool> host_renderer_presents = false;
+
+}  // namespace rex::gpu
diff --git a/src/gpu/xenos/xenos_graphics_driver_base.cpp b/src/gpu/xenos/xenos_graphics_driver_base.cpp
index 6fe403e1..a657b180 100644
--- a/src/gpu/xenos/xenos_graphics_driver_base.cpp
+++ b/src/gpu/xenos/xenos_graphics_driver_base.cpp
@@ -10,6 +10,7 @@
  */
 
 #include "gpu/xenos/xenos_graphics_driver_base.h"
+#include "gpu/xenos/host_renderer.h"
 
 #include <algorithm>
 #include <cctype>
@@ -49,8 +50,33 @@ rex::gpu::CommandProcessor::SwapPostEffect ParseSwapPostEffect(const std::string
   }
   return rex::gpu::CommandProcessor::SwapPostEffect::kNone;
 }
+std::atomic<rex::gpu::CommandProcessor*> host_renderer_source = nullptr;
+
 }  // namespace
 
+#if REX_PLATFORM_WIN32
+#define REX_HOST_RENDERER_EXPORT extern "C" __declspec(dllexport)
+#else
+#define REX_HOST_RENDERER_EXPORT extern "C" __attribute__((visibility("default")))
+#endif
+
+REX_HOST_RENDERER_EXPORT void rexgpu_host_renderer_draws(bool draws) {
+  rex::gpu::host_renderer_draws = draws;
+}
+
+REX_HOST_RENDERER_EXPORT void rexgpu_host_renderer_presents(bool presents) {
+  rex::gpu::host_renderer_presents = presents;
+}
+
+REX_HOST_RENDERER_EXPORT const void* rexgpu_gamma_ramp(bool pwl) {
+  const rex::gpu::CommandProcessor* source = host_renderer_source;
+  if (!source) {
+    return nullptr;
+  }
+  return pwl ? static_cast<const void*>(source->GetGammaRampPWLRGB())
+             : static_cast<const void*>(source->GetGammaRamp256EntryTable());
+}
+
 namespace rex::gpu {
 
 XenosGraphicsDriverBase::XenosGraphicsDriverBase() : vsync_worker_running_(false) {}
@@ -98,7 +124,7 @@ void XenosGraphicsDriverBase::ResizeSurface(u32 width, u32 height) {
 }
 
 bool XenosGraphicsDriverBase::BeginPresent() {
-  return presentation_ && presentation_->ConnectToWindow();
+  return !host_renderer_presents && presentation_ && presentation_->ConnectToWindow();
 }
 
 void XenosGraphicsDriverBase::RenderOverlays(ImDrawData& draw_data) {
@@ -147,6 +173,7 @@ Result<void> XenosGraphicsDriverBase::AttachTitle(const TitleInfo& info, IPhysic
   }
 
   command_processor_ = CreateCommandProcessor();
+  host_renderer_source = command_processor_.get();
   if (!command_processor_->Initialize()) {
     REXGPU_ERROR("Unable to initialize command processor");
     return Err(ErrorCategory::kRuntime, "Unable to initialize command processor");
@@ -198,6 +225,7 @@ void XenosGraphicsDriverBase::DetachTitle() {
 
   if (command_processor_) {
     command_processor_->Shutdown();
+    host_renderer_source = nullptr;
     command_processor_.reset();
   }
   shader_storage_opened_ = false;
